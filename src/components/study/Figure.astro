---
interface Props {
  caption: string;
  label?: string;
  pad?: boolean;
  /** Makes the figure clickable: enlarges in a dialog (JS) or opens the largest
   *  built image in a new tab (no-JS fallback). */
  zoom?: boolean;
}

const { caption, label, pad = true, zoom = false } = Astro.props;

// For zoomable figures, render the slot once, inspect it for the largest built
// image URL, and re-emit the same HTML inside the zoom trigger.
let zoomHref = "";
let slotHtml = "";
if (zoom) {
  slotHtml = await Astro.slots.render("default");
  let best = "";
  let bestWidth = 0;
  for (const match of slotHtml.matchAll(/srcset="([^"]+)"/g)) {
    for (const candidate of match[1].split(",")) {
      const [url, descriptor] = candidate.trim().split(/\s+/);
      const width = parseInt(descriptor || "0", 10);
      if (url && width > bestWidth) {
        best = url;
        bestWidth = width;
      }
    }
  }
  if (!best) {
    best = slotHtml.match(/src="([^"]+)"/)?.[1] ?? "";
  }
  zoomHref = best;
}
---

<figure class="figure">
  {
    zoom && zoomHref ? (
      <a class="figure-zoom" href={zoomHref} target="_blank" rel="noopener">
        <div class:list={["figure-frame", !pad && "figure-frame--bleed"]} set:html={slotHtml} />
      </a>
    ) : (
      <div class:list={["figure-frame", !pad && "figure-frame--bleed"]}>
        <slot />
      </div>
    )
  }
  <figcaption>
    {label && <span class="figure-label">{label}</span>}
    <span>{caption}</span>
  </figcaption>
</figure>

<script>
  const zoomLinks = document.querySelectorAll("a.figure-zoom");
  if (zoomLinks.length) {
    let dialog = null;
    let opener = null;

    const ensureDialog = () => {
      if (dialog) return dialog;
      dialog = document.createElement("dialog");
      dialog.className = "zoom-dialog";
      const img = document.createElement("img");
      img.alt = "";
      dialog.append(img);
      document.body.append(dialog);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        if (opener instanceof HTMLElement) opener.focus();
      });
      return dialog;
    };

    for (const link of zoomLinks) {
      link.addEventListener("click", (event) => {
        if (typeof HTMLDialogElement === "undefined") return; // fall back to the link
        event.preventDefault();
        const source = link.querySelector("img");
        const d = ensureDialog();
        const img = d.querySelector("img");
        img.src = link.href;
        img.alt = source ? source.alt : "";
        d.setAttribute("aria-label", source && source.alt ? source.alt : "Full-size image");
        opener = link;
        d.showModal();
      });
    }
  }
</script>
