---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyHeader from "../../components/study/StudyHeader.astro";
import StudyToc from "../../components/study/StudyToc.astro";
import Act from "../../components/study/Act.astro";
import DecisionCard from "../../components/study/DecisionCard.astro";
import Compare from "../../components/study/Compare.astro";
import Figure from "../../components/study/Figure.astro";
import AnnotatedFigure from "../../components/study/AnnotatedFigure.astro";
import EndBlock from "../../components/study/EndBlock.astro";
import { Image } from "astro:assets";
import screenOverview from "../../assets/tpl/screen-04-overview.png";
import screenSetup from "../../assets/tpl/screen-05-setup.png";
import screenQueue from "../../assets/tpl/screen-08-queue.png";
import screenRowReview from "../../assets/tpl/screen-07-row-review.png";
import screenReviewDecision from "../../assets/tpl/screen-06-review-decision.png";
import screenReviewEvidence from "../../assets/tpl/screen-09-review-evidence.png";
import screenWorkOrder from "../../assets/tpl/screen-10-work-order.png";
import "../../styles/study.css";

const acts = [
  { num: "01", title: "The scene" },
  { num: "02", title: "The constraint" },
  { num: "03", title: "The decisions" },
  { num: "04", title: "The work" },
  { num: "05", title: "The second pass" },
  { num: "06", title: "Impact & status" },
  { num: "07", title: "What I'd do differently" },
];
---

<BaseLayout
  title="SusTern TPL Platform — one decision at a time — Danilo Boquet"
  description="Redesigning third-party logistics operations: one review surface per record, an exception-first queue, and one locked vocabulary — then a second pass that split editing from deciding."
>
  <StudyHeader
    num="02"
    title="SusTern TPL Platform"
    hook="Third-party logistics is a queue of exceptions. My design goal: one home per record, one decision per row, and a queue that tells you what to do next."
    meta={[
      { label: "Role", value: "Product & UX design lead" },
      { label: "Company", value: "SusTern" },
      { label: "Timeline", value: "2025 — present" },
      { label: "Scope", value: "Intake, receiving, assembly, dispatch, billing, design system" },
    ]}
    outcome="Four review surfaces → one. Review edits in place; Approve decides. No new backend endpoints. Two confirmations — deliberately placed."
  />

  <StudyToc items={acts} />

  <Act num="01" title="The scene: a stack of documents, one question each">
    <p class="lede">
      It's morning at a third-party logistics provider. The day starts with a stack: packing
      lists, bills of lading, assemblies, return authorizations. Every document needs a call —
      accept it, correct it, chase it, or block it.
    </p>
    <p>
      When I took over the design, that work lived in four overlapping review surfaces: a row
      expansion, a facts modal, and two alternate views of the same extracted data. Operators had
      learned four patterns to do one thing. The vocabulary drifted too — the same state wore a
      different name on the nav, in the filter, and on the button.
    </p>
    <p>
      The tools worked. The design didn't. The rebuild answered one question: what does a
      provider see when the software is the calmest, most organized colleague on the floor? The
      TPL Platform is derived from the AI-Commerce platform, and it inherits the same principles:
      scoped context, evidence at hand, and one human decision at every commit.
    </p>
  </Act>

  <Act num="02" title="The constraint: providers run real operations">
    <ul class="constraints">
      <li>
        <strong>Multi-merchant by default.</strong>
        <span>
          A provider serves many client merchant workspaces at once. Every screen has to make its
          scope obvious — which client, which facility, which grant.
        </span>
      </li>
      <li>
        <strong>Evidence or it didn't happen.</strong>
        <span>
          These records move money and goods. Every decision keeps its paperwork attached, and
          irreversible actions are staged and confirmed.
        </span>
      </li>
      <li>
        <strong>Operators, not analysts.</strong>
        <span>
          Small teams in the middle of physical work. The queue has to tell them what's next
          without a manual.
        </span>
      </li>
    </ul>
  </Act>

  <Act num="03" title="The decisions">
    <DecisionCard
      title="One review surface per record"
      bet="A record opens in exactly one place: a fullscreen review with the decision state up top, evidence one reveal away, and provenance available but never in the way. Rows keep only a status chip, a reason line, and one action."
      alternative="Keep the four surfaces — a row expansion, a draft-facts modal, and alternate views of the same record."
      why="One place to act removes the oldest question in the room — “is this the same thing?” — and one pattern is learnable at a glance. Operators learn a decision, not a navigation."
    />
    <DecisionCard
      title="Exception-first queue with deterministic order"
      bet="The queue sorts by risk, not by time: conflicts first, then missing information, then needs review — and ready records fold quietly behind a “show ready” toggle. Every row derives exactly one action from its status."
      alternative="A chronological list where operators scan titles looking for problems."
      why="Attention is the scarce resource. When the queue orders itself by consequence, the workflow is the screen — nothing to memorize, nothing to hunt."
    />
    <DecisionCard
      title="Upload first, classify later — in one vocabulary"
      bet="A single upload surface stages documents before anything is classified; the role can be confirmed, corrected, or deferred. And one user-facing term per concept, locked — across nav, filters, buttons, and help."
      alternative="A wizard that interrogates you before accepting a file, with per-surface naming that drifts apart."
      why="People arrive holding a file and knowing why. Blocking the upload on classification slows the one thing they came to do — and terminology discipline is what makes a screen full of exceptions feel small."
    />
    <DecisionCard
      title="One workspace, scoped to context"
      bet="A single admin shell where you select the client namespace and the facility — and see only what your scope allows. Requirements appear as guidance (“requires a namespace, facility, and active grant”), not as disabled walls."
      alternative="Separate tools or skins per persona — provider, merchant, manufacturer."
      why="A small team can't maintain parallel products. One design language means one pattern library, one set of fixes, and screens that stay simple because context — not extra code — decides what's shown."
    />
    <div class="rejected">
      <p class="rejected-head">What we said no to</p>
      <ul>
        <li>A second upload path — one intake surface, no exceptions</li>
        <li>Four ways to review one record — one surface, one decision</li>
        <li>A confirmation on everything — we confirmed exactly two money actions</li>
        <li>A chronological queue — attention follows risk, not arrival time</li>
      </ul>
    </div>
  </Act>

  <Act num="04" title="The work">
    <p class="study-disclosure">
      Real product captures below are labelled “Sanitized capture” (provider demo workspace);
      composed figures are labelled “Reconstruction.”
    </p>
    <p class="group-label">The workspace</p>
    <div class="fig-grid fig-grid--2">
      <Figure
        label="Sanitized capture"
        caption="The morning view: one scoped home — client and facility in the header, exceptions counted above the fold. Zeros stay quiet; the counters with work in them carry the color."
        pad={false}
        zoom
      >
        <Image
          src={screenOverview}
          alt="Provider workspace overview: client and facility selectors, attention counters with inventory exceptions and receiving to review highlighted, performance score and SLA metrics, and client footprint tiles"
          widths={[640, 960, 1525]}
          sizes="(max-width: 720px) 92vw, 500px"
          loading="lazy"
        />
      </Figure>
      <Figure
        label="Sanitized capture"
        caption="Requirements as guidance, not walls: services confirmed, facility next, time estimates on each step, the form in place."
        pad={false}
        zoom
      >
        <Image
          src={screenSetup}
          alt="Workspace setup checklist with a progress bar, a completed provider services step, and an in-progress provider facility form"
          widths={[640, 960, 1614]}
          sizes="(max-width: 720px) 92vw, 500px"
          loading="lazy"
        />
      </Figure>
    </div>
    <div class="fig-grid">
      <AnnotatedFigure
        id="tpl-queue"
        label="Sanitized capture"
        caption="The consolidated workspace in practice: source documents, evidence, and domain handoffs in one queue — no second upload path. A needs-review record above a ready one, one reason line and one action per row, “Show ready” under the operator’s control."
        src={screenQueue}
        alt="Document intake queue with readiness guidance banners, filters including Show ready, a needs-review row with a Review issues action, and a ready row with its assembly handoff"
        widths={[640, 960, 1525]}
        sizes="(max-width: 720px) 92vw, 1040px"
        annotations={[
          {
            x: 73.8,
            y: 69.8,
            title: "Attention first",
            body: "Conflicts and missing information sort above ready records. The queue is ordered by consequence, not arrival time.",
          },
          {
            x: 94.5,
            y: 72.4,
            title: "One action per row",
            body: "Each document’s state derives exactly one action — Review issues, or continue to its workspace. No hunting.",
          },
          {
            x: 62.0,
            y: 33.2,
            title: "Ready stays folded",
            body: "The Show ready toggle keeps ready records out of the way until the operator asks for them.",
          },
        ]}
      />
      <Figure
        label="Sanitized capture"
        caption="The row, opened: draft facts arrive sectioned and counted — 46 findings, 78 flagged discrepancies — each batch accepted on its own, or all 46 at once. “Review and approve before these facts are used” is the rule; the record’s single decision surface is the fullscreen review."
        pad={false}
        zoom
      >
        <Image
          src={screenRowReview}
          alt="An intake row expanded into draft facts: finding and discrepancy counts with batch acceptance controls for the finished good, BOM components, routing steps, and tagged clips"
          widths={[640, 960, 1525]}
          sizes="(max-width: 720px) 92vw, 1040px"
          loading="lazy"
        />
      </Figure>
    </div>
    <Compare
      id="tpl-review-tabs"
      label="Review tabs"
      defaultTab="decision"
      tabs={[
        { id: "decision", label: "Decision" },
        { id: "evidence", label: "Evidence" },
      ]}
    >
      <Figure
        slot="decision"
        label="Sanitized capture"
        caption="One review surface per record: what acceptance will create is stated and counted — products, variants, inventory, BOM lines, routing, accepted mappings — with the gaps that still block attached to the same decision."
        pad={false}
        zoom
      >
        <Image
          src={screenReviewDecision}
          alt="Document review decision tab: the assembly handoff summary, reviewer reference and inventory location fields, approval action, missing-item flags, and a table of what acceptance will create"
          widths={[640, 960, 1525]}
          sizes="(max-width: 720px) 92vw, 1040px"
          loading="lazy"
        />
      </Figure>
      <Figure
        slot="evidence"
        label="Sanitized capture"
        caption="Evidence one reveal away: the document itself — pages stamped valid, findings grouped and batchable — and the unresolved counts said out loud: 0 of 14 pages accepted, 79 open questions."
        pad={false}
        zoom
      >
        <Image
          src={screenReviewEvidence}
          alt="Document review evidence tab: page thumbnails stamped valid, the source document viewer, an assembly-at-a-glance summary, and pending counts for page roles, details, and open questions"
          widths={[640, 960, 1525]}
          sizes="(max-width: 720px) 92vw, 1040px"
          loading="lazy"
        />
      </Figure>
    </Compare>
    <div class="fig-grid">
      <Figure
        label="Reconstruction"
        caption="One vocabulary, locked across every surface — one term per concept, the quiet work that makes the loud screens simple."
      >
        <div class="vocab">
          <div class="vocab-col vocab-dim">
            <h4>Before</h4>
            <ul>
              <li>Row expansion — “processed”</li>
              <li>Facts modal — “in progress”</li>
              <li>Alternate view A — “pending review”</li>
              <li>Alternate view B — “needs checking”</li>
            </ul>
          </div>
          <div class="vocab-col">
            <h4>After</h4>
            <ul>
              <li>Processing</li>
              <li>Needs review</li>
              <li>Conflicts</li>
              <li>Missing</li>
              <li>Ready</li>
            </ul>
          </div>
        </div>
      </Figure>
    </div>
    <p class="group-label">The floor</p>
    <div class="fig-grid">
      <Figure
        label="Sanitized capture"
        caption="The same grammar on the floor: one work order advances one bounded stage at a time, evidence coverage is stated honestly, and every exception carries an owner and a next action."
        pad={false}
        zoom
      >
        <Image
          src={screenWorkOrder}
          alt="Assembly work order detail: an evidence-coverage-blocked banner naming missing mappings, two ordered stages with their progress, execution actions, and an open partial-failure exception with owner and next action"
          widths={[640, 960, 1525]}
          sizes="(max-width: 720px) 92vw, 1040px"
          loading="lazy"
        />
      </Figure>
    </div>
    <p class="group-label">How this shipped</p>
    <div class="shipped">
      <div class="shipped-step">
        <span class="shipped-step-label">Audit</span>
        <p>11 friction points catalogued before any screen changed</p>
      </div>
      <div class="shipped-step">
        <span class="shipped-step-label">Decide</span>
        <p>One review surface per record; alternatives recorded and rejected</p>
      </div>
      <div class="shipped-step">
        <span class="shipped-step-label">Ship</span>
        <p>Phased delivery, each step behind acceptance gates</p>
      </div>
      <div class="shipped-step">
        <span class="shipped-step-label">Govern</span>
        <p>Patterns moved into the design system; guardrails run in CI</p>
      </div>
    </div>
  </Act>

  <Act num="05" title="The second pass: a workbench and a decision">
    <p class="lede">
      The first release made the review one surface. The second pass started from a simple
      observation: the review was still doing two jobs — correcting the record and making the
      decision — with the same editable components behind both tabs.
    </p>
    <p>
      Review carried a per-record confirm loop: accept this field, remove that one, repeat.
      Approve reused the same inputs with only the submit button hidden. Operators validated
      twice, filled in the reviewer reference twice, and had to guess which tab actually
      committed the document. The fix wasn't more polish. It was separating the jobs.
    </p>
    <p>
      Review is now a workbench: every extracted field is editable in place, fields can be
      included or excluded, advanced fields open in the row, and one save path persists the
      correction. Approve is read-only: it shows the final record and makes one decision for
      the complete included set. No per-record confirm, no second reviewer reference, and no
      edit control on Approve.
    </p>

    <DecisionCard
      title="Review is a workbench; Approve is the decision"
      bet="Split the tabs by job. Review edits — every field, include/exclude, one save path. Approve renders the final record read-only, and one action confirms every included field at once."
      alternative="Keep both tabs editable with a per-record Confirm and Remove loop — the model the first release shipped."
      why="Two tabs with the same behavior made the operator validate twice and choose a primary action twice. When a tab tells you what it's for, the decision is the only thing left on the screen."
    />
    <DecisionCard
      title="Edit in the table, not in a second form"
      bet="Make the review table the editor: prefilled, editable cells; document-wide fields moved to their own block; rare fields one row detail away. No Edit button, no synthetic editor row, no second modal. Saving is never approving."
      alternative="A summary row with an Edit button that opens a child form or a second modal."
      why="The source document has to stay visible while the operator corrects it. The table keeps evidence and edit in the same glance — the old pattern covered the evidence with the form and added a surface to maintain."
    />

    <p class="study-disclosure">
      No new captures were available for this pass, so the figure below reconstructs the
      shipped pattern from the design documentation. Sanitized captures are added as they clear
      review.
    </p>
    <Compare
      id="tpl-review-compare"
      label="Review before and after"
      defaultTab="after"
      tabs={[
        { id: "after", label: "After" },
        { id: "before", label: "Before" },
      ]}
    >
      <Figure
        slot="before"
        label="Reconstruction"
        caption="Before: two tabs, one behavior — a per-record confirm loop inside Review, and the same inputs again inside Approve."
      >
          <div class="fx">
            <div class="fx-bar">
              <span class="fx-dots"><span></span><span></span><span></span></span>
              <span class="fx-title">Document review — before</span>
            </div>
            <div class="fx-body">
              <p class="pass-state"><strong>Review</strong> and <strong>Approve</strong> — both editable</p>
              <div class="pass-itemrow">
                <span class="pass-item">Walnut dining chair</span>
                <span class="pass-meta">48 shipped · 46 received</span>
                <span class="pass-actions">
                  <span class="pass-action">Confirm</span>
                  <span class="pass-action pass-action-quiet">Remove</span>
                </span>
              </div>
              <div class="pass-itemrow">
                <span class="pass-item">Oak side table</span>
                <span class="pass-meta">24 shipped · 24 received</span>
                <span class="pass-actions">
                  <span class="pass-action">Confirm</span>
                  <span class="pass-action pass-action-quiet">Remove</span>
                </span>
              </div>
              <div class="pass-itemrow">
                <span class="pass-item">Walnut dining table</span>
                <span class="pass-meta">12 shipped · 12 received</span>
                <span class="pass-actions">
                  <span class="pass-action">Confirm</span>
                  <span class="pass-action pass-action-quiet">Remove</span>
                </span>
              </div>
              <div class="pass-foot">
                <span class="pass-meta">
                  Bill to, ship to, and document number repeat in every row.
                </span>
                <span class="pass-note">same components on Approve</span>
              </div>
            </div>
          </div>
      </Figure>
      <Figure
        slot="after"
        label="Reconstruction"
        caption="After: one job per tab — Review edits in place and saves; Approve is read-only and makes the only decision. The source document stays visible throughout."
      >
        <div class="fx">
            <div class="fx-bar">
              <span class="fx-dots"><span></span><span></span><span></span></span>
              <span class="fx-title">Document review — after</span>
            </div>
            <div class="fx-body">

              <p class="pass-label">Review — correct the record</p>
              <div class="pass-editrow">
                <span class="pass-check pass-check-on"></span>
                <span class="pass-item">Walnut dining chair</span>
                <span class="pass-qty">
                  <span class="pass-input">
                    48<span class="pass-input-label">shipped</span>
                  </span>
                  <span class="pass-input pass-input-focus">
                    46<span class="pass-input-label">received</span>
                  </span>
                </span>
                <span class="pass-detail">row detail</span>
              </div>
              <div class="pass-editrow">
                <span class="pass-check pass-check-on"></span>
                <span class="pass-item">Oak side table</span>
                <span class="pass-qty">
                  <span class="pass-input">
                    24<span class="pass-input-label">shipped</span>
                  </span>
                  <span class="pass-input">
                    24<span class="pass-input-label">received</span>
                  </span>
                </span>
                <span class="pass-detail">row detail</span>
              </div>
              <div class="pass-editrow">
                <span class="pass-check pass-check-on"></span>
                <span class="pass-item">Walnut dining table</span>
                <span class="pass-qty">
                  <span class="pass-input">
                    12<span class="pass-input-label">shipped</span>
                  </span>
                  <span class="pass-input">
                    12<span class="pass-input-label">received</span>
                  </span>
                </span>
                <span class="pass-detail">row detail</span>
              </div>
              <div class="pass-foot">
                <span class="pass-action pass-action-primary">Save changes</span>
                <span class="pass-note">saving never approves</span>
              </div>
              <div class="pass-divide"></div>
              <p class="pass-label">Approve — make the decision</p>
              <div class="pass-summary">
                <span><strong>3</strong> items included</span>
                <span><strong>2</strong> discrepancies resolved</span>
                <span><strong>1</strong> decision confirms all</span>
              </div>
              <div class="pass-foot">
                <span class="pass-action pass-action-primary">Approve document</span>
                <span class="pass-ref">Reviewer reference</span>
