---
interface Props {
  num: string;
  title: string;
}

const { num, title } = Astro.props;
---

<section class="act">
  <div class="container">
    <div class="act-head">
      <span class="act-num">{num}</span>
      <h2>{title}</h2>
    </div>
    <div class="act-body">
      <slot />
    </div>
  </div>
</section>
