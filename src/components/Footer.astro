---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="footer-note">&copy; {year} Danilo Boquet &middot; Ontario, Canada</p>
    <span class="footer-avail">
      <span class="avail-dot" aria-hidden="true"></span>Open to Senior/Lead product design roles
    </span>
    <nav class="footer-links" aria-label="Contact">
      <a href="mailto:danilo.boquet@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/danilo-de-resende-boquet/" rel="noopener">LinkedIn</a>
      <a href="/#work">Work</a>
      <a href="/resume/">Résumé</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 28px;
    background: var(--ink);
    color: color-mix(in srgb, var(--paper) 62%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .footer-links {
    display: flex;
    gap: 18px;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--paper);
  }

  .footer-avail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: 999px;
    padding: 6px 12px;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
  }

  .avail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
  }
</style>
