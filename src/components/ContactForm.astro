---
// Formspree endpoint — wired 2026-10-15. With JS the form posts via fetch and
// shows sending/success/error inline; without JS it posts natively to Formspree.
// If the service errors or the free tier caps, the status points to direct email.
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mnpjlbdz";
---

<form
  class="contact-form"
  data-endpoint={FORMSPREE_ENDPOINT}
  action={FORMSPREE_ENDPOINT}
  method="POST"
  novalidate
>
  <input type="hidden" name="_subject" value="Portfolio contact — danilo-designer.com" />
  <input
    type="text"
    name="_gotcha"
    class="cf-hp"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <div class="cf-row">
    <label>
      <span>Name</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
  </div>
  <label>
    <span>Message</span>
    <textarea name="message" rows="5" required></textarea>
  </label>
  <div class="cf-actions">
    <button class="btn cf-submit" type="submit">Send message</button>
    <p class="cf-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.querySelector("form.contact-form");
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector(".cf-status");
    const submit = form.querySelector(".cf-submit");
    const fallbackEmail = "danilo.boquet@gmail.com";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const message = String(data.get("message") || "").trim();

      if (!name || !email || !message) {
        if (status) status.textContent = "Please fill in name, email, and message.";
        return;
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        if (status) status.textContent = "That email doesn't look right.";
        return;
      }

      const endpoint = form.dataset.endpoint || "";
      if (endpoint) {
        if (status) status.textContent = "Sending…";
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: data,
          });
          if (response.ok) {
            form.reset();
            if (status) status.textContent = "Message sent — thank you. I'll reply soon.";
          } else {
            if (status) status.textContent = "That didn't send. Email me directly at " + fallbackEmail + ".";
          }
        } catch {
          if (status) status.textContent = "That didn't send. Email me directly at " + fallbackEmail + ".";
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      } else {
        const subject = encodeURIComponent("Portfolio contact — " + name);
        const body = encodeURIComponent(message + "\n\n— " + name + " (" + email + ")");
        window.location.href = "mailto:" + fallbackEmail + "?subject=" + subject + "&body=" + body;
        if (status) {
          status.textContent = "Opening your email app — or write me directly at " + fallbackEmail + ".";
        }
      }
    });
  }
</script>

<style>
  .contact-form {
    margin-top: 32px;
    display: grid;
    gap: 14px;
    max-width: 560px;
  }

  .cf-hp {
    display: none;
  }

  .cf-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  @media (max-width: 560px) {
    .cf-row {
      grid-template-columns: 1fr;
    }
  }

  .contact-form label span {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--paper) 25%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--paper) 6%, transparent);
    color: var(--paper);
    padding: 10px 12px;
    font: inherit;
    font-size: 0.95rem;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .cf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .cf-submit {
    border: none;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .cf-submit:hover {
    background: var(--accent);
    color: #fff;
  }

  .cf-status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }
</style>
